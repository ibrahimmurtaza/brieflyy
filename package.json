{
  "name": "brieflyy",
  "version": "0.0.1",
  "private": true,
  "description": "Brieflyy: aggregated, clustered, AI-summarized topic briefs.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets:check": "tsx src/verify/check-staged-secrets.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm secrets:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "ingest:check-feeds": "tsx src/ingest/check-feeds.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/sensible": "^6.0.0",
    "better-sqlite3": "^13.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "resend": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^26.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}