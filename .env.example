DATABASE_URL=file:./brieflyy.db
SESSION_SECRET=dev-only-change-me
APP_BASE_URL=http://localhost:3000

# Email transport. Set to "console" for local dev (no emails sent, links logged).
EMAIL_TRANSPORT=console
EMAIL_FROM=Brieflyy <hello@brieflyy.dev>

# When EMAIL_TRANSPORT=resend
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Magic link window in minutes (default 15).
MAGIC_LINK_TTL_MIN=15

# Session lifetime in days (default 30).
SESSION_TTL_DAYS=30