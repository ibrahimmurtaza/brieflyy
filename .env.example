DATABASE_URL=file:./brieflyy.db
APP_BASE_URL=http://localhost:3000

# Interface to listen on.
HOST=0.0.0.0
PORT=3000

# Email transport. Set to "resend" to send real email; "console" logs the
# message instead. Anything else fails at boot.
EMAIL_TRANSPORT=console
EMAIL_FROM=Brieflyy <hello@brieflyy.dev>

# Required when EMAIL_TRANSPORT=resend. Leave empty otherwise.
RESEND_API_KEY=

# OAuth provider. Set to "google" to enable Google sign-in, or leave it empty to
# disable sign-in with Google. Anything else fails at boot.
OAUTH_PROVIDER=

# Both required when OAUTH_PROVIDER=google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# LLM summary provider (optional). Without OPENAI_API_KEY, BriefSnapshot falls
# back to the extractive summary.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Embeddings provider (optional). Without OPENROUTER_API_KEY, every Story is
# formed exactly as before and carries no embedding, and grouping does not read
# one. A separate credential from the one above on purpose: a deployment may
# write briefs without embedding, and embed without writing.
#
# OPENROUTER_EMBEDDINGS_URL is OpenRouter's OpenAI-shaped embeddings endpoint.
# OPENROUTER_EMBEDDING_MODEL is the model asked for, and is only the default for
# what is recorded: the model stored beside each vector is the one the provider
# says produced it.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# How many Stories `pnpm cluster:backfill` asks about in one call. The endpoint is
# billed per request rather than per text, so this is what decides whether a
# corpus costs thousands of calls or hundreds of thousands. The endpoint
# publishes no maximum for the array it takes, so this is a default and not a
# limit: a size that is too large is not a failed run, because the backfill asks
# the same texts again one at a time and carries on. Formation never reads it.
OPENROUTER_EMBEDDING_BATCH_SIZE=16

# How long one embedding call may take. Formation holds this call in the middle
# of an ingest cycle, so a provider that accepts the request and never answers
# would hold the cycle rather than one Story's second reading. Past this the
# Story forms without an embedding, which it did before embeddings existed.
EMBEDDING_CALL_TIMEOUT_MS=5000

# Payments. Set all three to take them, or none: a half-configured instance is
# refused at boot rather than offering a checkout it cannot finish. With none,
# /upgrade says billing is not connected and POST /billing/checkout answers 503,
# which is a complete configuration — an instance that takes no payments is a free
# one, not a broken Brieflyy.
#
# STRIPE_WEBHOOK_SECRET is the signing secret of the endpoint, not the API key:
# it is never presented to anybody and only answers whether an event came from
# Stripe. Point a Stripe webhook at APP_BASE_URL + /billing/webhook for
# checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAID_PRICE_ID=

# How many Clusters one brief carries, most active first. Defaults to five.
BRIEF_MAX_CLUSTERS=5

# How many of the leading Clusters of a brief are written rather than quoted.
# Defaults to five; 0 turns the written path off without unsetting the key. A
# value larger than BRIEF_MAX_CLUSTERS writes the whole brief, which is the only
# reading of the two that means anything. A brief past the top N, or past the
# time budget below, is quoted from its Articles instead.
BRIEF_GENERATED_CLUSTERS=5

# The two bounds on writing. A call that outruns its own timeout falls back for
# that Cluster; a brief that outruns the budget quotes everything after it,
# because it is due to a User at their own DeliveryTime and the schedule does
# not move for one slow call. The timeout may not exceed the budget, and boot
# refuses a pair that does rather than leaving the budget unreachable.
BRIEF_GENERATION_CALL_TIMEOUT_MS=8000
BRIEF_GENERATION_BUDGET_MS=15000

# Background ingest. Defaults to true. The scheduler only registers the ingest
# routes when this is on, and the loop starts and stops with the process.
INGEST_ENABLED=true

# How often the loop polls, and how a failing Source backs off. A sign-in runs a
# cycle too, so this is the floor between refreshes rather than the only one. The
# backoff doubles per consecutive failure, from the base up to the ceiling.
INGEST_INTERVAL_MS=21600000
INGEST_BACKOFF_BASE_MS=60000
INGEST_BACKOFF_MAX_MS=1800000

# The daily brief job. Every User picks their own DeliveryTime in their own
# timezone, so there is no one time of day for it to run at: it looks for the
# Users who are owed a brief on an interval, and one missed while the process was
# down is sent when it comes back. Defaults to on; the status view at
# /admin/briefs reports whether the loop is running either way.
BRIEFS_ENABLED=true
BRIEFS_INTERVAL_MS=60000

# Development-only routes, including the switch that moves your own account onto
# the paid tier (POST /dev/tier) so the topic-cap paywall can be exercised.
# Defaults to on outside production and off when NODE_ENV=production; a
# production instance registers no such route at all.
DEV_TOOLS_ENABLED=

# Mark the session cookie Secure. Leave empty to follow NODE_ENV.
COOKIE_SECURE=

# Trust X-Forwarded-For, so the magic-link rate limit counts callers separately
# behind a reverse proxy. Only turn this on when a proxy you control sets the
# header, or a caller can pretend to be someone else.
TRUST_PROXY=false

# Set by the runtime; read only to pick the COOKIE_SECURE default.
NODE_ENV=development
